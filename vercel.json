{
  "version": 2,
  "functions": {
    "api/metadata.js": {
      "maxDuration": 15
    },
    "api/auth.js": {
      "maxDuration": 10
    },
    "api/dispatch.js": {
      "maxDuration": 15
    },
    "api/status.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
